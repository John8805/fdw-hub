# 複製成 .env。這個檔案只放埠號，帳密一律用 .\dbhub.ps1 set 存進加密檔 .env.enc。

# hub（PostgreSQL）對外埠，DBeaver 連這個
HUB_PORT=5433
# DBHub（MCP）對外埠
DBHUB_PORT=8080
# 預設只有本機能連。要讓區網連線才打開，DBHub 沒有登入驗證，請謹慎
# HUB_BIND=0.0.0.0

# 需要用 .\dbhub.ps1 set 寫入的變數（名稱對應 config.yaml 裡的 ${...}）
#   HUB_ADMIN_PASSWORD      hub 管理員 postgres 的密碼（自訂強密碼）
#   AI_READER_PASSWORD      唯讀小帳號 ai_reader 的密碼（自訂強密碼）
#   BASTION_B_SSH_PASSWORD  密碼認證跳板機的密碼
#   SHOP_PG_USER / SHOP_PG_PASSWORD
#   SHOP_MARIA_USER / SHOP_MARIA_PASSWORD
#   SHOP_STG_DB_USER / SHOP_STG_DB_PASSWORD
